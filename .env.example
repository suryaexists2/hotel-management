# ─── Application ─────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql://innsight:innsight_dev@localhost:5432/innsight?schema=public

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Email (Nodemailer) ─────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@innsight.io

# ─── File Storage ────────────────────────────────────
# Options: "local" | "s3"
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Trusted reverse-proxy hops (0 = direct/no proxy). Set to the number of proxies
# in front of the API in production so client IP / rate limiting can't be spoofed.
TRUST_PROXY=0

# ─── Logging ────────────────────────────────────────
LOG_LEVEL=debug
