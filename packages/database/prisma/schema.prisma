datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── TENANT (HOTEL) ─────────────────────────────────

model Hotel {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  address         String
  city            String
  state           String?
  country         String
  zipCode         String?
  phone           String
  email           String
  website         String?
  logoUrl         String?
  timezone        String   @default("UTC")
  currency        String   @default("USD")
  currencySymbol  String   @default("$")
  checkInTime     String   @default("14:00")
  checkOutTime    String   @default("11:00")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  roles           Role[]
  roomTypes       RoomType[]
  rooms           Room[]
  guests          Guest[]
  reservations    Reservation[]
  folios          Folio[]
  taxRules        TaxRule[]
  menuItems       MenuItem[]
  inventoryItems  InventoryItem[]
  employees       Employee[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  settings        HotelSettings?
  orders          Order[]
  housekeepingTasks HousekeepingTask[]
  maintenanceOrders MaintenanceOrder[]
  suppliers       Supplier[]
  guestBackups    GuestBackup[]
  dailyAnalytics  DailyAnalytics[]
}

model HotelSettings {
  id                String   @id @default(cuid())
  hotelId           String   @unique
  supportedCurrencies String  @default("[\"USD\"]")
  defaultTaxRate    Decimal  @default(0.0)
  allowOverbooking  Boolean  @default(false)
  overbookingLimit  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// ─── AUTH & RBAC ────────────────────────────────────

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  status          String      @default("ACTIVE")
  failedAttempts  Int         @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  hotelId         String
  roleId          String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  updatedBy       String?

  hotel           Hotel       @relation(fields: [hotelId], references: [id])
  role            Role        @relation(fields: [roleId], references: [id])
  refreshTokens   RefreshToken[]
  employee        Employee?
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([hotelId])
  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  hotelId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([hotelId, name])
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String?

  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  replacedBy  String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

// ─── ROOMS ──────────────────────────────────────────

model RoomType {
  id              String   @id @default(cuid())
  hotelId         String
  name            String
  description     String?
  baseRate        Decimal
  maxOccupancy    Int
  maxAdults       Int
  maxChildren     Int      @default(0)
  amenities       String   @default("[]")
  images          String   @default("[]")
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  rooms           Room[]
  reservations    Reservation[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model Room {
  id              String     @id @default(cuid())
  hotelId         String
  roomTypeId      String
  roomNumber      String
  floor           Int
  status          String     @default("AVAILABLE")
  notes           String?
  isActive        Boolean    @default(true)
  lastCleanedAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  hotel           Hotel      @relation(fields: [hotelId], references: [id])
  roomType        RoomType   @relation(fields: [roomTypeId], references: [id])
  reservations    Reservation[]
  housekeepingTasks HousekeepingTask[]
  maintenanceOrders MaintenanceOrder[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
  @@index([hotelId, roomTypeId])
}

// ─── GUESTS ─────────────────────────────────────────

model Guest {
  id              String    @id @default(cuid())
  hotelId         String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  nationality     String?
  idType          String?
  idNumber        String?
  idProofFront    String?
  idProofBack     String?
  address         String?
  city            String?
  country         String?
  vipLevel        Int       @default(0)
  preferences     String?
  notes           String?
  totalStays      Int       @default(0)
  totalSpent      Decimal   @default(0)
  lastStayAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hotel           Hotel     @relation(fields: [hotelId], references: [id])
  reservations    Reservation[]
  backup          GuestBackup?

  @@index([hotelId, lastName, firstName])
  @@index([hotelId, email])
  @@index([hotelId, phone])
}

model GuestBackup {
  id              String    @id @default(cuid())
  guestId         String    @unique
  hotelId         String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  nationality     String?
  idType          String?
  idNumber        String?
  idProofFront    String?
  idProofBack     String?
  address         String?
  city            String?
  country         String?
  vipLevel        Int       @default(0)
  preferences     String?
  notes           String?
  totalStays      Int       @default(0)
  totalSpent      Decimal   @default(0)
  lastStayAt      DateTime?
  backedUpAt      DateTime  @default(now())
  deletedAt       DateTime?

  guest           Guest     @relation(fields: [guestId], references: [id])
  hotel           Hotel     @relation(fields: [hotelId], references: [id])

  @@index([hotelId, backedUpAt])
}

// ─── RESERVATIONS ───────────────────────────────────

model Reservation {
  id                String             @id @default(cuid())
  hotelId           String
  confirmationNo    String             @unique
  guestId           String
  roomId            String?
  roomTypeId        String
  checkInDate       DateTime
  checkOutDate      DateTime
  nights            Int
  adults            Int                @default(1)
  children          Int                @default(0)
  ratePerNight      Decimal
  totalAmount       Decimal
  status            String             @default("PENDING")
  source            String             @default("DIRECT")
  specialRequests   String?
  internalNotes     String?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?

  hotel             Hotel              @relation(fields: [hotelId], references: [id])
  guest             Guest              @relation(fields: [guestId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  folio             Folio?
  occupants         Occupant[]

  @@index([hotelId, status])
  @@index([hotelId, checkInDate, checkOutDate])
  @@index([guestId])
  @@index([confirmationNo])
}

// ─── OCCUPANTS / COMPANION GUESTS ────────────────────

model Occupant {
  id              String     @id @default(cuid())
  reservationId   String
  firstName       String
  lastName        String
  gender          String?
  dateOfBirth     DateTime?
  phone           String?
  email           String?
  idType          String?
  idNumber        String?
  idProofFront    String?
  idProofBack     String?
  relationship    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

// ─── BILLING ────────────────────────────────────────

model Folio {
  id              String       @id @default(cuid())
  hotelId         String
  folioNumber     String       @unique
  reservationId   String       @unique
  guestId         String
  status          String       @default("OPEN")
  currency        String       @default("USD")
  totalCharges    Decimal      @default(0)
  totalPayments   Decimal      @default(0)
  totalTax        Decimal      @default(0)
  totalDiscounts  Decimal      @default(0)
  balance         Decimal      @default(0)
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hotel           Hotel        @relation(fields: [hotelId], references: [id])
  reservation     Reservation  @relation(fields: [reservationId], references: [id])
  charges         FolioCharge[]
  payments        Payment[]
  invoices        Invoice[]
  orders          Order[]

  @@index([hotelId])
  @@index([guestId])
}

model FolioCharge {
  id              String          @id @default(cuid())
  folioId         String
  category        String
  description     String
  amount          Decimal
  taxAmount       Decimal         @default(0)
  quantity        Int             @default(1)
  unitPrice       Decimal
  date            DateTime        @default(now())
  isVoided        Boolean         @default(false)
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  createdAt       DateTime        @default(now())
  createdBy       String?

  folio           Folio           @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@index([folioId, category])
}

model Payment {
  id              String        @id @default(cuid())
  folioId         String
  amount          Decimal
  method          String
  status          String        @default("COMPLETED")
  referenceNo     String?
  notes           String?
  processedAt     DateTime      @default(now())
  refundedAmount  Decimal?
  refundedAt      DateTime?
  refundReason    String?
  voidedAt        DateTime?
  voidReason      String?
  voidedBy        String?
  createdAt       DateTime      @default(now())
  createdBy       String?
  gatewayProvider String        @default("MANUAL")

  folio           Folio         @relation(fields: [folioId], references: [id])

  @@index([folioId])
}

model Invoice {
  id              String   @id @default(cuid())
  hotelId         String
  folioId         String
  invoiceNumber   String   @unique
  guestName       String
  guestEmail      String?
  subtotal        Decimal
  taxTotal        Decimal
  discountTotal   Decimal  @default(0)
  grandTotal      Decimal
  currency        String   @default("USD")
  taxBreakdown    String
  lineItems       String
  issuedAt        DateTime @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  folio           Folio    @relation(fields: [folioId], references: [id])

  @@index([hotelId])
  @@index([folioId])
}

model TaxRule {
  id              String   @id @default(cuid())
  hotelId         String
  name            String
  rate            Decimal
  appliesTo       String   @default("[]")
  isInclusive     Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel           Hotel    @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
}

// ─── HOUSEKEEPING ───────────────────────────────────

model HousekeepingTask {
  id              String      @id @default(cuid())
  hotelId         String
  roomId          String
  assignedTo      String?
  status          String      @default("PENDING")
  priority        String      @default("MEDIUM")
  type            String      @default("CHECKOUT_CLEAN")
  notes           String?
  inspectedBy     String?
  inspectedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  hotel           Hotel       @relation(fields: [hotelId], references: [id])
  room            Room        @relation(fields: [roomId], references: [id])
  assignedEmployee Employee?   @relation("AssignedHousekeeping", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([hotelId, status])
  @@index([assignedTo])
}

// ─── MAINTENANCE ────────────────────────────────────

model MaintenanceOrder {
  id              String              @id @default(cuid())
  hotelId         String
  roomId          String?
  title           String
  description     String
  priority        String              @default("P3_MEDIUM")
  status          String              @default("OPEN")
  assignedTo      String?
  reportedBy      String
  estimatedCost   Decimal?
  actualCost      Decimal?
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  resolution      String?
  images          String              @default("[]")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hotel           Hotel               @relation(fields: [hotelId], references: [id])
  room            Room?               @relation(fields: [roomId], references: [id])
  assignedEmployee Employee?   @relation("AssignedMaintenance", fields: [assignedTo], references: [id], onDelete: SetNull)
  reportingEmployee Employee    @relation("ReportedMaintenance", fields: [reportedBy], references: [id])

  @@index([hotelId, status])
  @@index([hotelId, priority])
}

// ─── RESTAURANT & ROOM SERVICE ──────────────────────

model MenuItem {
  id              String   @id @default(cuid())
  hotelId         String
  name            String
  description     String?
  category        String
  price           Decimal
  isAvailable     Boolean  @default(true)
  isVegetarian    Boolean  @default(false)
  allergens       String   @default("[]")
  imageUrl        String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  orderItems      OrderItem[]

  @@index([hotelId, category])
}

model Order {
  id              String      @id @default(cuid())
  hotelId         String
  orderNumber     String      @unique
  type            String
  status          String      @default("RECEIVED")
  roomNumber      String?
  tableNumber     String?
  guestId         String?
  folioId         String?
  subtotal        Decimal
  taxAmount       Decimal     @default(0)
  total           Decimal
  specialInstructions String?
  orderedAt       DateTime    @default(now())
  preparedAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?

  hotel           Hotel       @relation(fields: [hotelId], references: [id])
  items           OrderItem[]
  folio           Folio?      @relation(fields: [folioId], references: [id], onDelete: SetNull)

  @@index([hotelId, status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  menuItemId  String
  quantity    Int
  unitPrice   Decimal
  total       Decimal
  notes       String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
}

// ─── INVENTORY ──────────────────────────────────────

model InventoryItem {
  id              String   @id @default(cuid())
  hotelId         String
  name            String
  category        String
  sku             String?
  unit            String
  currentStock    Int      @default(0)
  reorderLevel    Int      @default(10)
  costPerUnit     Decimal?
  supplierId      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  movements       StockMovement[]
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([hotelId, name])
  @@index([hotelId, category])
}

model Supplier {
  id              String   @id @default(cuid())
  hotelId         String
  name            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  inventoryItems  InventoryItem[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model StockMovement {
  id              String            @id @default(cuid())
  itemId          String
  type            String
  quantity        Int
  previousStock   Int
  newStock        Int
  reason          String?
  referenceNo     String?
  createdAt       DateTime          @default(now())
  createdBy       String?

  item            InventoryItem     @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

// ─── EMPLOYEES ──────────────────────────────────────

model Employee {
  id              String    @id @default(cuid())
  hotelId         String
  userId          String?   @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  department      String
  position        String
  employeeCode    String?
  dateOfJoining   DateTime
  emergencyContact String?
  emergencyPhone  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hotel           Hotel     @relation(fields: [hotelId], references: [id])
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  housekeepingTasks HousekeepingTask[] @relation("AssignedHousekeeping")
  assignedMaintenance MaintenanceOrder[] @relation("AssignedMaintenance")
  reportedMaintenance MaintenanceOrder[] @relation("ReportedMaintenance")

  @@unique([hotelId, employeeCode])
  @@index([hotelId, department])
}

// ─── AUDIT & ACTIVITY ───────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  hotelId     String
  userId      String?
  action      String
  entity      String
  entityId    String
  oldValues   String?
  newValues   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  hotel       Hotel       @relation(fields: [hotelId], references: [id])
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@index([hotelId, entity, entityId])
  @@index([userId])
}

// ─── ANALYTICS ───────────────────────────────────────

model DailyAnalytics {
  id               String   @id @default(cuid())
  hotelId          String
  date             DateTime
  totalGuests      Int      @default(0)
  totalReservations Int     @default(0)
  checkIns         Int      @default(0)
  checkOuts        Int      @default(0)
  cancellations    Int      @default(0)
  totalRevenue     Decimal  @default(0)
  totalRoomsBooked Int      @default(0)
  occupancyRate    Decimal  @default(0)
  avgNights        Decimal  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, date])
}

model Notification {
  id          String           @id @default(cuid())
  hotelId     String
  userId      String
  type        String
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  hotel       Hotel            @relation(fields: [hotelId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hotelId, userId, isRead])
  @@index([createdAt])
}
